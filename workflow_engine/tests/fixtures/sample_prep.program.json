{
  "programVersion": 2,
  "name": "WorkflowCompilerFixture",
  "description": "Neutral DomainProgram for platform compile and CLI tests",
  "projectPath": "${var.projectPath}",
  "variables": {
    "ready": {
      "schemaRef": "schemas/vars/bool.schema.json",
      "description": "Demo gate from demo.echo output binding"
    }
  },
  "body": [
    {
      "do": "demo.echo",
      "node_key": "echo",
      "with": {"message": "compile-fixture"},
      "out": {"ready": "$.value"}
    },
    {
      "for": {
        "collection": "samples",
        "item": "sample",
        "index": "sampleIndex",
        "parallel": true
      },
      "do": [
        {
          "do": "demo.touch",
          "node_key": "touch",
          "with": {"sampleId": "${var.sample.sampleId}"}
        }
      ]
    }
  ]
}
