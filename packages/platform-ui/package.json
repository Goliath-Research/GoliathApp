{
  "name": "@goliath/platform-ui",
  "version": "0.1.0",
  "description": "Goliath platform screen framework — fixtures and shell primitives (P0)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
