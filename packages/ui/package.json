{
  "name": "@goliath/ui",
  "version": "0.1.0",
  "description": "Goliath platform UI primitives, icon registry, and presentation tokens",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.470.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^27.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
