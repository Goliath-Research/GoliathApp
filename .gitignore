# Local MkDocs build. Pull-request CI builds the site; the Pages workflow publishes it from main.
site/

# Editable install metadata
*.egg-info/

# Fetched third-party binaries (pinned by third_party/*.lock)
third_party/vendor/

# Exograph build artifacts
exo/target/
exo/generated/
exo/node_modules/
node_modules/
packages/*/dist/
apps/platform-host/.next/
apps/platform-host/test-results/
apps/platform-host/playwright-report/
apps/platform-host/.e2e/
apps/platform-host/tests/e2e/.auth/
packages/*/*.tgz
**/*.tsbuildinfo
exo/src/*.deno.lock
__pycache__/
