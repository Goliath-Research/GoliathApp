{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Goliath-Research/GoliathApp/blob/main/.goliath/product.schema.json",
  "title": "Goliath product summary",
  "description": "Machine-readable product summary read at site build time. The same schema is shared by every product. dependsOn lists upstream product ids only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "tagline",
    "description",
    "category",
    "features",
    "links",
    "related",
    "license",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Markdown, two to four sentences."
    },
    "category": {
      "type": "string",
      "enum": ["platform", "application", "component"]
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "docs", "website"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "docs": {
          "anyOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "website": {
          "anyOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+$"
      },
      "uniqueItems": true
    },
    "dependsOn": {
      "type": "array",
      "description": "Upstream product ids this product depends on. Omit or use an empty array at the top of the hierarchy. Do not list products that extend this one.",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+$"
      },
      "uniqueItems": true
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    }
  }
}
